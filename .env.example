# ==============================================================================
# Telegram Medya (Video & Fotoğraf) İndirici & Aktarıcı Yapılandırma Dosyası
# Bu dosyayı '.env' olarak kopyalayın ve kendi bilgilerinizi girin.
# Komut: cp .env.example .env
# ==============================================================================

# 1. TELEGRAM API BİLGİLERİ (my.telegram.org adresinden alınır)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Telegram'a giriş yapılacak telefon numarası (Ülke kodu ile: +905551234567)
TELEGRAM_PHONE=+905551234567

# Oturum dosya adı (session ismi)
SESSION_NAME=telegram_syncer_session

# 2. MEDYA TÜRÜ AYARI
# all   : Hem videoları hem fotoğrafları indir ve aktar (Varsayılan)
# video : Yalnızca videoları indir ve aktar
# photo : Yalnızca fotoğrafları indir ve aktar
MEDIA_TYPE=all

# 3. KANAL VE TOPIC (KONU) AYARLARI
# Kaynak Kanal ID'leri veya Kullanıcı Adları (Virgülle ayırarak birden fazla yazabilirsiniz)
# Örn: -1001234567890, @kaynak_kanal, https://t.me/kaynak_kanal
SOURCE_CHANNELS=-1001234567890

# KAYNAK KANAL TOPIC / KONU FİLTRESİ (OPSİYONEL)
# Kaynak kanal forum modundaysa ve TÜM konular yerine YALNIZCA BELİRLİ bir konudaki medyaları indirmek istiyorsanız:
# Telegram Web'deki URL'de görünen thread ID'sini veya standart Topic ID'sini yazın (örn: 5914 veya URL'deki uzun sayı).
# Birden fazla konu için virgülle ayırabilirsiniz: 5914, 1234
# Tüm konuları indirmek için boş bırakın.
SOURCE_TOPIC_IDS=

# Hedef Kanal ID'si veya Kullanıcı Adı (Medyaların yükleneceği kanal)
# Örn: -1009876543210 veya @hedef_kanal
TARGET_CHANNEL=-1009876543210

# HEDEF KANAL TOPIC (KONU) ID'Sİ (OPSİYONEL)
# Eğer hedef kanal Konu/Topic modundaysa ve medyaları belirli bir konuya yüklemek istiyorsanız Topic ID'sini girin.
# Ana kanala yüklemek için boş veya 0 bırakın.
TARGET_TOPIC_ID=0

# 4. İNDİRME VE YÜKLEME AYARLARI
# İndirilen medyaların kaydedileceği geçici klasör
DOWNLOAD_DIR=downloads

# Yükleme tamamlandıktan sonra yerel dosyayı diskten sil (Yer tasarrufu için True önerilir)
AUTO_CLEANUP=true

# Maksimum indirilecek medya boyutu (MB cinsinden, 0 = limitsiz, Telegram üst sınırı 2000 MB / Premium için 4000 MB)
MAX_FILE_SIZE_MB=0

# Minimum video süresi (Saniye cinsinden, örn: 5 saniyeden kısa videoları atla, 0 = limitsiz)
MIN_DURATION_SECONDS=0

# Maksimum tekrar deneme sayısı (İndirme/yükleme hatası durumunda)
MAX_RETRIES=5

# Tekrar denemeler arası taban bekleme süresi (Saniye cinsinden)
RETRY_DELAY_SECONDS=5

# İki yükleme arasındaki bekleme süresi (Telegram Flood/Spam koruması için saniye)
DELAY_BETWEEN_UPLOADS=3

# Orijinal başlığı/açıklamayı (caption) koru veya özel metin ekle
# true: Orijinal açıklamayı korur
# false: Açıklama eklemez
KEEP_ORIGINAL_CAPTION=true

# Özel başlık/açıklama eki (Opsiyonel)
CUSTOM_CAPTION_PREFIX=
CUSTOM_CAPTION_SUFFIX=
