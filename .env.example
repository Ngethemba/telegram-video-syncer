# ==============================================================================
# Telegram Video İndirici & Aktarıcı Yapılandırma Dosyası
# Bu dosyayı '.env' olarak kopyalayın ve kendi bilgilerinizi girin.
# Komut: cp .env.example .env
# ==============================================================================

# 1. TELEGRAM API BİLGİLERİ (my.telegram.org adresinden alınır)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Telegram'a giriş yapılacak telefon numarası (Ülke kodu ile: +905551234567)
TELEGRAM_PHONE=+905551234567

# Oturum dosya adı (session ismi)
SESSION_NAME=telegram_syncer_session

# 2. KANAL VE TOPIC (KONU) AYARLARI
# Kaynak Kanal ID'leri veya Kullanıcı Adları (Virgülle ayırarak birden fazla yazabilirsiniz)
# Örn: -1001234567890, @kaynak_kanal, https://t.me/kaynak_kanal
SOURCE_CHANNELS=-1001234567890

# KAYNAK KANAL TOPIC / KONU FİLTRESİ (OPSİYONEL)
# Kaynak kanal forum modundaysa ve TÜM konular yerine YALNIZCA BELİRLİ bir konudaki videoları indirmek istiyorsanız:
# Telegram Web'deki URL'de görünen 'thread=4294973210' veya doğrudan '4294973210' ya da '5914' yazabilirsiniz.
# Birden fazla konu için virgülle ayırabilirsiniz: 4294973210, 1234
# Tüm konuları indirmek için boş bırakın.
SOURCE_TOPIC_IDS=4294973210

# Hedef Kanal ID'si veya Kullanıcı Adı (Videoların yükleneceği kanal)
# Örn: -1009876543210 veya @hedef_kanal
TARGET_CHANNEL=-1009876543210

# HEDEF KANAL TOPIC (KONU) ID'Sİ (OPSİYONEL)
# Eğer hedef kanal Konu/Topic modundaysa ve videoları belirli bir konuya yüklemek istiyorsanız Topic ID'sini girin.
# (Örn: 4294973210 veya 5914). Ana kanala yüklemek için boş veya 0 bırakın.
TARGET_TOPIC_ID=0

# 3. İNDİRME VE YÜKLEME AYARLARI
# İndirilen videoların kaydedileceği geçici klasör
DOWNLOAD_DIR=downloads

# Yükleme tamamlandıktan sonra yerel video dosyasını diskten sil (Yer tasarrufu için True önerilir)
AUTO_CLEANUP=true

# Maksimum indirilecek video boyutu (MB cinsinden, 0 = limitsiz, Telegram üst sınırı 2000 MB / Premium için 4000 MB)
MAX_FILE_SIZE_MB=0

# Minimum video süresi (Saniye cinsinden, örn: 5 saniyeden kısa videoları atla, 0 = limitsiz)
MIN_DURATION_SECONDS=0

# Maksimum tekrar deneme sayısı (İndirme/yükleme hatası durumunda)
MAX_RETRIES=5

# Tekrar denemeler arası taban bekleme süresi (Saniye cinsinden)
RETRY_DELAY_SECONDS=5

# İki video yüklemesi arasındaki bekleme süresi (Telegram Flood/Spam koruması için saniye)
DELAY_BETWEEN_UPLOADS=3

# Orijinal video açıklamasını (caption) koru veya özel metin ekle
# true: Orijinal açıklamayı korur
# false: Açıklama eklemez
KEEP_ORIGINAL_CAPTION=true

# Özel başlık/açıklama eki (Opsiyonel)
CUSTOM_CAPTION_PREFIX=
CUSTOM_CAPTION_SUFFIX=
