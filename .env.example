# ==============================================================================
# Telegram Media Syncer Configuration File
# Copy this file to '.env' and fill in your credentials.
# Command: cp .env.example .env (Linux) or copy .env.example .env (Windows)
# ==============================================================================

# 0. LANGUAGE / DIL AYARI (tr = Turkce, en = English)
LANGUAGE=tr

# 1. TELEGRAM API CREDENTIALS (from my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Account phone number with country code (e.g. +905551234567)
TELEGRAM_PHONE=+905551234567

# Session name
SESSION_NAME=telegram_syncer_session

# 2. MEDIA TYPE FILTER
# all   : Both videos and photos (Default)
# video : Videos only
# photo : Photos only
MEDIA_TYPE=all

# 3. CHANNELS & FORUM TOPIC SETTINGS
# Source channel IDs or usernames (comma-separated for multiple)
# Example: -1001234567890, @source_channel
SOURCE_CHANNELS=-1001234567890

# SOURCE FORUM TOPIC ID FILTER (OPTIONAL)
# If source channel is a forum supergroup, specify Topic ID (or leave blank for all)
SOURCE_TOPIC_IDS=

# Target channel ID or username where media will be uploaded
TARGET_CHANNEL=-1009876543210

# TARGET FORUM TOPIC ID (OPTIONAL)
# If target channel is a forum supergroup, specify destination Topic ID (0 for general)
TARGET_TOPIC_ID=0

# 4. DOWNLOAD & UPLOAD SETTINGS
DOWNLOAD_DIR=downloads

# Delete local file after upload (true recommended)
AUTO_CLEANUP=true

# Maximum file size in MB (0 = unlimited)
MAX_FILE_SIZE_MB=0

# Minimum video duration in seconds (0 = unlimited)
MIN_DURATION_SECONDS=0

# Max retries on failure
MAX_RETRIES=5

# Retry base delay in seconds
RETRY_DELAY_SECONDS=5

# Delay between consecutive uploads (seconds)
DELAY_BETWEEN_UPLOADS=3

# Caption settings
KEEP_ORIGINAL_CAPTION=true
CUSTOM_CAPTION_PREFIX=
CUSTOM_CAPTION_SUFFIX=
